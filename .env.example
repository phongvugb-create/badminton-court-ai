# ==========================================================================
# BADMINTON AI MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================================================

# Google Gemini AI API Configuration
GEMINI_API_KEY=

# Application Web Server Port
PORT=8085
NODE_ENV=development

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123
POSTGRES_DB=badminton_ai_db
DATABASE_URL=postgresql://postgres:admin123@badminton_ai_postgres:5432/badminton_ai_db

# Redis Cache (Slot Hold Atomic Lock)
REDIS_URL=redis://badminton_ai_redis:6379

# Payment Gateway Configuration (VNPay)
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
