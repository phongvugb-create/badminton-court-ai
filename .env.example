# ==========================================================================
# BADMINTON AI MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================================================

# Google Gemini AI API Configuration
GEMINI_API_KEY=

# Application Web Server Port
PORT=8085
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/badminton_ai_db

# Redis Cache (Slot Hold Atomic Lock)
REDIS_URL=redis://localhost:6379

# Payment Gateway Configuration (VNPay)
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
