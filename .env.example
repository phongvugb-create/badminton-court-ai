# ==========================================================================
# BADMINTON AI MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================================================

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=30
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
RETRIEVAL_SIMILARITY_THRESHOLD=0.58
RAG_TOP_K=3

# Application Web Server Port
PORT=8085
NODE_ENV=development

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123
POSTGRES_DB=badminton_ai_db
DATABASE_URL=postgresql://postgres:admin123@badminton_ai_postgres:5432/badminton_ai_db

# Redis Cache (Slot Hold Atomic Lock)
REDIS_URL=redis://badminton_ai_redis:6379

# Payment Gateway Configuration (VNPay)
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Payment Gateway Configuration (MoMo Phase 7.4B / Phase 11.1)
MOMO_ENVIRONMENT=sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_REDIRECT_URL=
MOMO_IPN_URL=
MOMO_PARTNER_NAME=Badminton AI
MOMO_STORE_ID=BadmintonCourt01
MOMO_TIMEOUT_SECONDS=30.0

